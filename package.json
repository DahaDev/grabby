{
  "name": "grabby",
  "version": "0.1.0",
  "description": "Local video downloader for YouTube, Instagram, TikTok, Snapchat",
  "main": "src/main/main.js",
  "author": {
    "name": "Daha",
    "email": "you@example.com"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/DahaDev/grabby",
  "repository": {
    "type": "git",
    "url": "https://github.com/DahaDev/grabby.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node scripts/fetch-binaries.js",
    "icon": "python3 build/make-icon.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "publish": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.daha.grabby",
    "productName": "Grabby",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Daha",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*"
    ],
    "extraResources": [
      {
        "from": "vendor/${os}-${arch}/",
        "to": "vendor/${os}-${arch}/",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "LSMinimumSystemVersion": "10.13.0"
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.png",
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 140, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Daha"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grabby"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
